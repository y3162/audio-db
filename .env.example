# Copy to .env and set the paths on this machine.
# `source .env` and `make` both read this file. Values already exported in the
# shell win over the file. PLATFORM is not set here.
#
# export AUDIO_DB_DATASET_ROOT="/path/to/datasets"
# export UV_CACHE_DIR="/path/to/uv-cache"

export AUDIO_DB_DATASET_ROOT=
export UV_CACHE_DIR=

# Optional. When set, this path is used instead of $AUDIO_DB_DATASET_ROOT/<source name>.
export AUDIO_DB_CORPUS_CHIME3=
export AUDIO_DB_CORPUS_DEMAND=
export AUDIO_DB_CORPUS_DNS5=
export AUDIO_DB_CORPUS_DNS2020=
export AUDIO_DB_CORPUS_MS_SNSD=
export AUDIO_DB_CORPUS_LIBRISPEECH=
export AUDIO_DB_CORPUS_LIBRITTS=
export AUDIO_DB_CORPUS_OPENSLR26=
export AUDIO_DB_CORPUS_OPENSLR28=
export AUDIO_DB_CORPUS_URGENT2024=
export AUDIO_DB_CORPUS_VCTK=
export AUDIO_DB_CORPUS_VOICEBANK_DEMAND=
