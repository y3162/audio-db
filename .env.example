# Copy to .env and replace the dataset root with your own absolute path.
# Values already exported in the shell take precedence.
export AUDIO_DB_DATASET_ROOT="/path/to/datasets"

# Set this if you keep the uv cache in a separate directory.
# export UV_CACHE_DIR="/path/to/uv-cache"

