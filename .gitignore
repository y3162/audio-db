# agent settings
# Shared and tracked: AGENTS.md, CLAUDE.md, .agents/, .cursor/rules/, .codex/README.md.
# Anything else under .cursor/ and .codex/ is local (MCP tokens, auth, caches) and stays untracked.
/.cursor/*
!/.cursor/rules/
/.codex/*
!/.codex/README.md
/.claude/settings.local.json
CLAUDE.local.md
AGENTS.override.md
/PROMPT.md
/OUTPUT.md
.env
.env.*
!.env.example

# .gitkeep
/.venvs/*
!/.venvs/.gitkeep
/data/*/*
/data/staging/
!/data/checkpoints/.gitkeep
!/data/results/.gitkeep
!/data/db/.gitkeep
!/data/corpora/.gitkeep

# program cache
__pycache__/
/build/

# official implementation
/src/se/official/

# VoiceBank noise investigation trees stay on disk and out of Git.
# Agent constraints are in .agents/. Reusable scripts are in scripts/data/voicebank/.
/research_voicebank_*/
